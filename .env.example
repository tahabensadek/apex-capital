# Copy to .env.local (local) or set in Vercel > Project > Settings > Environment Variables.

# --- Public site ---
NEXT_PUBLIC_CONTACT_PHONE=+15148248618
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=(514) 824-8618
NEXT_PUBLIC_CONTACT_EMAIL=info@capitalfacile.ca
# Client success fee in percent. Set to 0 to remove the fee everywhere on the site.
NEXT_PUBLIC_SUCCESS_FEE_PCT=6

NEXT_PUBLIC_SITE_URL=https://capitalfacile.ca

# --- Google Ads (Goals > Conversions). Leave empty to disable the tag and the cookie banner. ---
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Label of the "Lead" conversion action (the part after the slash in send_to "AW-123/AbC...").
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Name of the offline conversion action for funded deals (CSV export at /api/leads/google-ads-conversions).
GOOGLE_ADS_FUNDED_CONVERSION_NAME=Funded deal

# --- Lead storage: Vercel > Storage > Upstash for Redis injects these automatically. ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Lead alerts (5-minute callback) ---
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
# Phone that gets the "NEW LEAD — CALL NOW" text. Defaults to the public contact phone.
ADMIN_PHONE=
# Long random string. Signs the one-tap lead links in the alert SMS (openssl rand -base64 32).
LEAD_LINK_SECRET=
# Durable copy of every lead (e.g. Make/Zapier webhook -> Google Sheet). Strongly recommended on Vercel,
# where the data/*.json files cannot be written.
LEAD_WEBHOOK_URL=

# --- Internal pages (/leads, /crm, /board, /financials, /admin) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Plaid (portal bank connection) ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
